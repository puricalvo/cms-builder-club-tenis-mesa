---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/ui/BackToTop.astro";
import { getTable } from "../services/pages";

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "CTM San Juan | Club de Tenis de Mesa",
  description = "Club de Tenis de Mesa de San Juan de Aznalfarache. Competición, deporte y pasión por el tenis de mesa."
} = Astro.props;

// Recuperar la configuración general del club
const configuracionesCMS = await getTable("configuraciones");
const configuracion = configuracionesCMS[0] ?? {};

// Recuperar el color principal
const colorPrincipal = configuracion.primary_color_configuracion || "#091D36";

// Escudo del club desde CMS Builder, con imagen local de respaldo
const escudoClub =
  configuracion.logo_configuracion || "/images/escudo-club.png";

// Nombre del club desde CMS Builder
const nombreClub =
  configuracion.name_configuracion || "CTM San Juan";

// Localidad del club desde CMS Builder
const localidadClub =
  configuracion.city_configuracion || "SAN JUAN DE AZNALFARACHE";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#102B50" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=DM+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body style={`--color-club-primary: ${colorPrincipal};`}>
    <Header
      escudoClub={escudoClub}
      nombreClub={nombreClub}
      localidadClub={localidadClub}
    />

    <main>
      <slot />
    </main>

    <Footer />
    <BackToTop />
  </body>
</html>
