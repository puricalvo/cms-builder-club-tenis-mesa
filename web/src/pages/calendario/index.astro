---
import Layout from "../../layouts/Layout.astro";
import { getTable } from "../../services/pages";
import { decode } from "../../services/utils";

import "../../styles/calendario.css";

type Evento = {
  title: string;
  description: string;
  date: string;
  time: string;
  type: string;
  category: string;
  location: string;
  opponent: string;
  homeAway: string;
  status: string;
};

// Recuperar los eventos del CMS Builder
const registros = await getTable("calendarios");

// Preparar los datos
const eventos: Evento[] = registros
  .map((registro: any): Evento => {
    const type = decode(registro.type_calendario ?? "");
    const opponent = decode(registro.opponent_calendario ?? "");
    const homeAway = decode(registro.home_away_calendario ?? "");

    const esPartido = type.trim().toLowerCase() === "partido";
    const esVisitante = homeAway.trim().toLowerCase() === "visitante";

    const titleOriginal = decode(registro.title_calendario ?? "");

    const title =
      esPartido && opponent
        ? esVisitante
          ? `${opponent} vs CTM San Juan`
          : `CTM San Juan vs ${opponent}`
        : titleOriginal;

    return {
      title,
      description: decode(registro.description_calendario ?? ""),
      date: String(registro.date_calendario ?? "").slice(0, 10),
      time: String(registro.time_calendario ?? "").slice(0, 5),
      type,
      category: decode(registro.category_calendario ?? ""),
      location: decode(registro.location_calendario ?? ""),
      opponent,
      homeAway,
      status: decode(registro.status_calendario ?? "")
    };
  })
  .filter((evento: Evento) => Boolean(evento.date && evento.title))
  .sort((a: Evento, b: Evento) => a.date.localeCompare(b.date));

const today = new Date();

const todayKey = [
  today.getFullYear(),
  String(today.getMonth() + 1).padStart(2, "0"),
  String(today.getDate()).padStart(2, "0")
].join("-");

const proximosEventos = eventos.filter((evento: Evento) => {
  const estado = evento.status.trim().toLowerCase();

  return (
    evento.date >= todayKey &&
    estado === "programado"
  );
});

const formatDate = (date: string) => {
  const [year, month, day] = date.split("-").map(Number);

  return new Intl.DateTimeFormat("es-ES", {
    day: "numeric",
    month: "long",
    year: "numeric"
  }).format(new Date(year, month - 1, day));
};
---

<Layout
  title="Calendario | CTM San Juan"
  description="Consulta los próximos partidos, torneos y actividades del Club de Tenis de Mesa San Juan de Aznalfarache."
>
  <section class="section calendar-section">
    <div class="container">

      <header class="calendar-header">
        <span class="eyebrow">CTM SAN JUAN</span>

        <h1 class="calendar-title">
          CALENDARIO DE ACTIVIDADES
        </h1>

        <p class="calendar-subtitle">
          Consulta los próximos partidos, torneos y actividades
          de nuestro club.
        </p>
      </header>

      <div class="calendar-layout">

        <!-- CALENDARIO MENSUAL -->
        <div class="calendar-card">

          <div class="calendar-toolbar">
            <h2 class="calendar-month-title" id="calendar-month">
              Calendario
            </h2>

            <div class="calendar-controls">
              <button
                type="button"
                class="calendar-nav-btn"
                id="calendar-prev"
                aria-label="Mes anterior"
              >
                ‹
              </button>

              <button
                type="button"
                class="calendar-nav-btn"
                id="calendar-next"
                aria-label="Mes siguiente"
              >
                ›
              </button>
            </div>
          </div>

          <div class="calendar-weekdays">
            {["L", "M", "X", "J", "V", "S", "D"].map((day) => (
              <div class="calendar-weekday">{day}</div>
            ))}
          </div>

          <div
            class="calendar-days"
            id="calendar-days"
            aria-label="Días del mes"
            data-events={JSON.stringify(eventos)}
          ></div>

        </div>

        <!-- PRÓXIMOS EVENTOS -->
        <aside class="calendar-events-card">

          <div class="calendar-events-header">
            <h2 class="calendar-events-title" id="calendar-events-title">
                Próximos eventos
            </h2>

            <button
                type="button"
                class="calendar-reset-btn"
                id="calendar-reset"
                hidden
            >
                Ver próximos eventos
            </button>
          </div>

          <div id="calendar-events">
            {
              proximosEventos.length === 0 ? (
                <p class="calendar-empty">
                  Todavía no hay eventos disponibles.
                </p>
              ) : (
                proximosEventos.map((evento) => (
                  <article class="calendar-event">

                    <span class="calendar-event-type">
                      {evento.type}
                    </span>

                    <h3 class="calendar-event-title">
                      {evento.type.trim().toLowerCase() === "partido" && evento.opponent ? (
                        <>
                          {evento.homeAway.trim().toLowerCase() === "visitante"
                            ? evento.opponent
                            : "CTM San Juan"}

                          <span class="match-vs">VS</span>

                          {evento.homeAway.trim().toLowerCase() === "visitante"
                            ? "CTM San Juan"
                            : evento.opponent}
                        </>
                      ) : (
                        evento.title
                      )}
                    </h3>

                    {evento.category && (
                      <span class="calendar-event-category">{evento.category}</span>
                    )}

                    <div class="calendar-event-meta">
                      <p>📅 {formatDate(evento.date)}</p>
                      {evento.time && <p>🕒 {evento.time} h</p>}
                      {evento.location && <p>📍 {evento.location}</p>}
                      {evento.status && (
                        <p>
                            Estado:{" "}
                            <span class={`calendar-event-status ${evento.status.trim().toLowerCase()}`}>
                            {evento.status}
                            </span>
                        </p>
                      )}
                    </div>

                  </article>
                ))
              )
            }
          </div>

        </aside>

      </div>
    </div>
  </section>
</Layout>

<script>
  const monthTitle = document.querySelector<HTMLElement>("#calendar-month");
  const daysContainer = document.querySelector<HTMLElement>("#calendar-days");
  const previousButton = document.querySelector<HTMLButtonElement>("#calendar-prev");
  const nextButton = document.querySelector<HTMLButtonElement>("#calendar-next");

  type CalendarEvent = {
    title: string;
    description: string;
    date: string;
    time: string;
    type: string;
    category: string;
    location: string;
    opponent: string;
    homeAway: string;
    status: string;
  };

const calendarEvents: CalendarEvent[] = JSON.parse(
  daysContainer?.dataset.events ?? "[]"
);

const eventDates = calendarEvents.map((evento) => evento.date); 
const eventsContainer = document.querySelector<HTMLElement>("#calendar-events");
const eventsTitle = document.querySelector<HTMLElement>(
  "#calendar-events-title"
);
const resetButton = document.querySelector<HTMLButtonElement>(
  "#calendar-reset"
);

const originalEvents = eventsContainer?.innerHTML ?? "";

const filterEventsByDate = (selectedDate: string) => {
  if (!eventsContainer) return;

  if (resetButton) {
    resetButton.hidden = false;
  }

  if (eventsTitle) {
    const [year, month, day] = selectedDate.split("-").map(Number);

    const formattedDate = new Intl.DateTimeFormat("es-ES", {
        day: "numeric",
        month: "long",
        year: "numeric"
    }).format(new Date(year, month - 1, day));

    eventsTitle.textContent = `Eventos del ${formattedDate}`;
  }

  const selectedEvents = calendarEvents.filter(
    (evento) => evento.date === selectedDate
  );

  eventsContainer.replaceChildren();

  if (selectedEvents.length === 0) {
    const message = document.createElement("p");
    message.className = "calendar-empty";
    message.textContent = "No hay eventos programados para este día.";
    eventsContainer.appendChild(message);
    return;
  }

  selectedEvents.forEach((evento) => {
    const article = document.createElement("article");
    article.className = "calendar-event";

    const type = document.createElement("span");
    type.className = "calendar-event-type";
    type.textContent = evento.type;

    const category = document.createElement("span");
    category.className = "calendar-event-category";
    category.textContent = evento.category;

    const title = document.createElement("h3");
    title.className = "calendar-event-title";

    const esPartido =
      evento.type.trim().toLowerCase() === "partido";

    const esVisitante =
      evento.homeAway?.trim().toLowerCase() === "visitante";

    if (esPartido && evento.opponent) {
      const equipoLocal = esVisitante
        ? evento.opponent
        : "CTM San Juan";

      const equipoVisitante = esVisitante
        ? "CTM San Juan"
        : evento.opponent;

      const vs = document.createElement("span");
      vs.className = "match-vs";
      vs.textContent = "VS";

      title.append(
        document.createTextNode(equipoLocal),
        vs,
        document.createTextNode(equipoVisitante)
      );
    } else {
      title.textContent = evento.title;
    }

    const meta = document.createElement("div");
    meta.className = "calendar-event-meta";

    const addDetail = (label: string, value: string) => {
      if (!value) return;

      const paragraph = document.createElement("p");
      paragraph.textContent = `${label} ${value}`;
      meta.appendChild(paragraph);
    };

    addDetail("🕒", evento.time ? `${evento.time} h` : "");
    addDetail("📍", evento.location);
    if (evento.status) {
        const statusRow = document.createElement("p");
        statusRow.textContent = "Estado: ";

        const statusBadge = document.createElement("span");
        statusBadge.className = `calendar-event-status ${evento.status.trim().toLowerCase()}`;
        statusBadge.textContent = evento.status;

        statusRow.appendChild(statusBadge);
        meta.appendChild(statusRow);
    }

    article.append(type);

    if (evento.category) {
    article.appendChild(category);
    }

    article.append(title, meta);
    eventsContainer.appendChild(article);
  });
};

  resetButton?.addEventListener("click", () => {
    if (!eventsContainer) return;

    eventsContainer.innerHTML = originalEvents;

    if (eventsTitle) {
        eventsTitle.textContent = "Próximos eventos";
    }

    document.querySelectorAll(".calendar-day.selected").forEach((element) => {
        element.classList.remove("selected");
    });

    resetButton.hidden = true;
  });

  let currentDate = new Date();
  currentDate.setDate(1);

  const renderCalendar = () => {
    if (!monthTitle || !daysContainer) return;

    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();

    monthTitle.textContent = new Intl.DateTimeFormat("es-ES", {
      month: "long",
      year: "numeric"
    }).format(currentDate);

    daysContainer.replaceChildren();

    const firstDay = (new Date(year, month, 1).getDay() + 6) % 7;
    const daysInMonth = new Date(year, month + 1, 0).getDate();

    for (let i = 0; i < firstDay; i++) {
      const emptyDay = document.createElement("div");
      emptyDay.className = "calendar-day empty";
      emptyDay.setAttribute("aria-hidden", "true");
      daysContainer.appendChild(emptyDay);
    }

    for (let day = 1; day <= daysInMonth; day++) {
    const dayElement = document.createElement("button");
    dayElement.type = "button";
    dayElement.className = "calendar-day";
    dayElement.textContent = String(day);

      const dateKey = [
        year,
        String(month + 1).padStart(2, "0"),
        String(day).padStart(2, "0")
        ].join("-");

        if (eventDates.includes(dateKey)) {
        dayElement.classList.add("has-event");
      }

      dayElement.addEventListener("click", () => {
        document.querySelectorAll(".calendar-day.selected").forEach((element) => {
            element.classList.remove("selected");
        });

        dayElement.classList.add("selected");

        filterEventsByDate(dateKey);
      });

      const today = new Date();

      if (
        day === today.getDate() &&
        month === today.getMonth() &&
        year === today.getFullYear()
      ) {
        dayElement.classList.add("today");
      }

      daysContainer.appendChild(dayElement);
    }
  };

  previousButton?.addEventListener("click", () => {
    currentDate.setMonth(currentDate.getMonth() - 1);
    renderCalendar();
    resetButton?.click();
  });

  nextButton?.addEventListener("click", () => {
    currentDate.setMonth(currentDate.getMonth() + 1);
    renderCalendar();
    resetButton?.click();
  });

  renderCalendar();
</script>
