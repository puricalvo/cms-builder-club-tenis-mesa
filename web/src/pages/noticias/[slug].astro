---
import Layout from "../../layouts/Layout.astro";

import { getTable } from "../../services/pages";
import { decode } from "../../services/utils";
import "../../styles/noticia-detalle.css";

type Noticia = {
  id_noticia: number;
  title_noticia: string;
  subtitle_noticia: string;
  description_noticia: string;
  image_noticia: string;
  slug_noticia: string;
  destacada_noticia: string;
  status_noticia: string;
};

// Recuperar todas las noticias del CMS
export async function getStaticPaths() {
  const noticias = await getTable("noticias");

  return noticias
    .filter((noticia: any) =>
      noticia.status_noticia === "Publicada" &&
      noticia.slug_noticia
    )
    .map((noticia: any) => ({
      params: {
        slug: decode(noticia.slug_noticia)
      },
      props: {
        noticia
      }
    }));
}

 const { noticia } = Astro.props as { noticia: Noticia };

// Preparar los campos de la noticia
const title = decode(noticia.title_noticia ?? "");
const subtitle = decode(noticia.subtitle_noticia ?? "");
const description = decode(noticia.description_noticia ?? "");
const image = decode(noticia.image_noticia ?? "");
---

<Layout
  title={`${title || "Noticia"} | CTM San Juan`}
  description={subtitle}
>

  <section class="section article-section">

    <div class="container">

      <article class="news-article">

        <a href="/" class="text-link back-link">
          ← Volver a Inicio
        </a>

        <header class="article-header">

          <span class="eyebrow">
            {subtitle}
          </span>

          <h1 class="article-title">
            {title}
          </h1>

          <p class="article-subtitle">
            {subtitle}
          </p>

        </header>

        {image && (
          <img
            src={image}
            alt={title}
            class="article-image"
          />
        )}

        <div
          class="article-description"
          set:html={description}
        ></div>

        <div class="article-footer">

          <a href="/noticias" class="btn btn-primary">
            ← Volver a Noticias
          </a>

        </div>

      </article>

    </div>

  </section>

</Layout>

