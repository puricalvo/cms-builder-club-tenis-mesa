---
import Layout from "../layouts/Layout.astro";

import { getTable } from "../services/pages";
import { decode } from "../services/utils";

// Recuperar las noticias desde el CMS
const noticiasCMS = await getTable("noticias");

// Recuperar los datos de la portada desde el CMS
const inicioCMS = await getTable("inicios");
const inicio = inicioCMS[0] ?? {};

// Recuperar los partidos del calendario desde el CMS
const calendariosCMS = await getTable("calendarios");

// Contenidos de la portada con valores de respaldo
const heroTitle = decode(
  inicio.title_inicio || "PASIÓN POR EL TENIS DE MESA"
);

const heroSubtitle = decode(
  inicio.subtitle_inicio || "Club de Tenis de Mesa · Sevilla"
);

const heroDescription = decode(
  inicio.description_inicio ||
  "Bienvenidos al Club de Tenis de Mesa San Juan. Un club donde el esfuerzo, la competición y el compañerismo se encuentran alrededor de una mesa."
);

const heroImage = decode(
  inicio.image_inicio || "/images/portada-ctm-san-juan.avif"
);

// Contenidos de la sección Nuestra identidad
const identityEyebrow = decode(
  inicio.identity_eyebrow_inicio || "Nuestra identidad"
);

const identityTitle = decode(
  inicio.identity_title_inicio || "SOMOS CTM SAN JUAN. SOMOS EQUIPO."
);

const identityDescription = decode(
  inicio.identity_description_inicio ||
  "Representamos a San Juan de Aznalfarache con ilusión, esfuerzo y pasión por el tenis de mesa. Queremos seguir creciendo dentro y fuera de la competición."
);

const identityButtonText = decode(
  inicio.identity_button_text_inicio || "Descubre nuestro club"
);

const identityButtonUrl = decode(
  inicio.identity_button_url_inicio || "/club"
);

// Mantener EL TENIS destacado en amarillo
const titleParts = heroTitle.split(/(EL TENIS)/i);

// Estructura de las noticias
type NewsItem = {
  category: string;
  title: string;
  description: string;
  image: string;
  url: string;
};

// Seleccionar las 3 noticias publicadas y destacadas más recientes
const news: NewsItem[] = noticiasCMS
  .filter((noticia: any) =>
    noticia.status_noticia === "Publicada" &&
    noticia.destacada_noticia === "Si" &&
    noticia.slug_noticia
  )
  .sort((a: any, b: any) =>
    (b.date_created_noticia ?? "").localeCompare(
      a.date_created_noticia ?? ""
    )
  )
  .slice(0, 3)
  .map((noticia: any) => ({
    category: decode(noticia.subtitle_noticia ?? ""),
    title: decode(noticia.title_noticia ?? ""),
    description: decode(noticia.description_noticia ?? ""),
    image: decode(noticia.image_noticia ?? ""),
    url: `/noticias/${decode(noticia.slug_noticia)}`
  }));

// Preparar los próximos partidos desde el CMS
const today = new Date();

const todayKey = [
  today.getFullYear(),
  String(today.getMonth() + 1).padStart(2, "0"),
  String(today.getDate()).padStart(2, "0")
].join("-");

const matches = calendariosCMS
  .map((registro: any) => ({
    league: decode(registro.category_calendario ?? ""),
    date: String(registro.date_calendario ?? "").slice(0, 10),
    time: String(registro.time_calendario ?? "").slice(0, 5),
    home: "CTM SAN JUAN",
    away: decode(registro.opponent_calendario ?? ""),
    homeAway: decode(registro.home_away_calendario ?? ""),
    location: decode(registro.location_calendario ?? ""),
    type: decode(registro.type_calendario ?? ""),
    status: decode(registro.status_calendario ?? "")
  }))
  .filter((match: any) =>
    match.date >= todayKey &&
    match.status.trim().toLowerCase() === "programado" &&
    match.type.trim().toLowerCase() === "partido"
  )
  .sort((a: any, b: any) =>
    `${a.date} ${a.time}`.localeCompare(`${b.date} ${b.time}`)
  )
  .map((match: any) => {
  const esVisitante =
    match.homeAway.trim().toLowerCase() === "visitante";

  return {
    ...match,
    home: esVisitante ? match.away : "CTM SAN JUAN",
    away: esVisitante ? "CTM SAN JUAN" : match.away,
    date: `${match.date.split("-").reverse().join("/")} · ${match.time}`
  };
});
---

<Layout
  title="CTM San Juan | Club de Tenis de Mesa"
  description="Web oficial del Club de Tenis de Mesa San Juan de Aznalfarache. Consulta partidos, resultados y noticias."
>

  <!-- PORTADA -->

  <section
    class="hero"
    style={`--hero-image: url("${heroImage.replace(/["\\\r\n]/g, "")}")`}
  >
    <div class="hero-content">

      <span class="hero-label">
        {heroSubtitle}
      </span>

      <h1>
        {titleParts.map((part) =>
          part.toUpperCase() === "EL TENIS" ? (
            <span>{part}</span>
          ) : (
            part
          )
        )}
      </h1>

      <p class="hero-description">
        {heroDescription}
      </p>

      <div class="hero-actions">
        <a href="/calendario" class="btn btn-primary">
          Próximos partidos <span>→</span>
        </a>

        <a href="/club" class="btn btn-outline">
          Conoce nuestro club
        </a>
      </div>

    </div>
  </section>

  <!-- PRESENTACIÓN -->

  <section class="intro-strip">

    <div class="intro-item">
      <span class="intro-number">01</span>
      <div>
        <strong>COMPETICIÓN</strong>
        <small>Superación y espíritu deportivo</small>
      </div>
    </div>

    <div class="intro-item">
      <span class="intro-number">02</span>
      <div>
        <strong>COMPAÑERISMO</strong>
        <small>Un club, una familia</small>
      </div>
    </div>

    <div class="intro-item">
      <span class="intro-number">03</span>
      <div>
        <strong>SAN JUAN</strong>
        <small>Orgullo de nuestro municipio</small>
      </div>
    </div>

  </section>

  <!-- PRÓXIMOS PARTIDOS -->

  <section class="section matches-section">

    <div class="container">

      <div class="section-heading">
        <div>
          <span class="eyebrow">En la mesa</span>
          <h2 class="section-title">Próximos partidos</h2>
          <p class="section-description">
            Sigue los próximos encuentros de nuestros equipos.
          </p>
        </div>

        <a href="/calendario" class="text-link">
          Ver calendario completo →
        </a>
      </div>

      <div class="match-grid">

        {matches.map((match: any) => (
          <article class="match-card">

            <span class="match-league">{match.league}</span>

            <p class="match-date">{match.date}</p>

            <div class="match-teams">

              <div class="match-team">
                {match.home}
                <small>LOCAL</small>
              </div>

              <span class="match-vs">VS</span>

              <div class="match-team">
                {match.away}
                <small>VISITANTE</small>
              </div>

            </div>

            <div class="match-location">
              📍 {match.location}
            </div>

          </article>
        ))}

      </div>

    </div>

  </section>

  <!-- NOTICIAS -->

  <section class="section">

    <div class="container">

      <div class="section-heading">
        <div>
          <span class="eyebrow">Actualidad</span>
          <h2 class="section-title">Noticias del club</h2>
          <p class="section-description">
            Toda la actualidad del CTM San Juan.
          </p>
        </div>

        <a href="/noticias" class="text-link">
          Todas las noticias →
        </a>
      </div>

      <div class="news-grid">

        {news.map((item) => (
          <article class="news-card">

            {item.image && (
              <img
                src={item.image}
                alt={item.title}
                class="news-image"
                loading="lazy"
              />
            )}

            <div class="news-content">

              <span class="news-category">
                {item.category}
              </span>

              <h3 class="news-title">
                {item.title}
              </h3>

              <p class="news-description">
                {item.description}
              </p>

              <a href={item.url} class="news-more">
                Más información →
              </a>

            </div>

          </article>
        ))}

      </div>

    </div>

  </section>

  <!-- PRESENTACIÓN DEL CLUB -->

  <!-- PRESENTACIÓN DEL CLUB -->

  <section class="club-banner">

    <div class="container">

      <div class="club-banner-content">

        <span class="eyebrow" style="color: var(--yellow)">
          {identityEyebrow}
        </span>

        <h2>
          {identityTitle}
        </h2>

        <p>
          {identityDescription}
        </p>

        <a href={identityButtonUrl} class="btn btn-primary">
          {identityButtonText} →
        </a>

      </div>

    </div>

  </section>

</Layout>
