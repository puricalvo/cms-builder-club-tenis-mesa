---
const links = [
  { label: "Inicio", href: "/", id: "inicio" },
  { label: "El club", href: "/club", id: "club" },
  { label: "Calendario", href: "/calendario", id: "calendario" },
  { label: "Resultados", href: "/resultados", id: "resultados" },
  { label: "Noticias", href: "/noticias", id: "noticias" }
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="header-inner">

    <a href="/" class="brand" aria-label="CTM San Juan - Inicio">
      <img
        src="/images/escudo-club.png"
        alt="Escudo del Club de Tenis de Mesa San Juan"
        class="brand-logo"
      />

      <span class="brand-text">
        <strong>CTM SAN JUAN</strong>
        <small>SAN JUAN DE AZNALFARACHE</small>
      </span>
    </a>

    <button
      class="menu-toggle"
      id="menu-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="main-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="main-navigation" id="main-navigation">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "nav-link",
            { active: currentPath === link.href || currentPath === link.href + "/" }
          ]}
        >
          {link.label}
        </a>
      ))}

      <a href="/contacto" class="header-cta">
        Contacto <span>↗</span>
      </a>
    </nav>

  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
  const navigation = document.querySelector<HTMLElement>("#main-navigation");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";

    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Abrir menú" : "Cerrar menú");

    navigation?.classList.toggle("menu-open", !isOpen);
  });

  navigation?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-label", "Abrir menú");
      navigation?.classList.remove("menu-open");
    });
  });
</script>
